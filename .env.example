# Speech-to-text and text-to-speech
SARVAM_API_KEY=your_sarvam_api_key

# Daily key from the Pipecat Cloud account (api.daily.co). Not the pk_ agent key.
DAILY_API_KEY=your_daily_api_key

# Gemini answers and File Search indexing (GEMINI_API_KEY is also accepted)
GOOGLE_API_KEY=your_google_api_key

# Optional. Leave unset to use the store created by `python -m rag.indexer`.
FILE_SEARCH_STORE=

# FastAPI server
HOST=127.0.0.1
PORT=7860

# Voice language (en-IN, hi-IN, ta-IN, te-IN, etc.)
SARVAM_LANGUAGE=en-IN

# Optional model overrides
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=shubh
GEMINI_LLM_MODEL=gemini-3.8-flash

# Optional textbook location
NCERT_DATA_DIR=data
